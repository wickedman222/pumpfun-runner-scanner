# Fill these in Railway → your service → Variables
# (or copy this file to .env for a local run)

# Required — from @BotFather (full string, includes the colon)
TELEGRAM_BOT_TOKEN=123456789:AA....your_bot_token

# Required — channel / group / user chat id
# Channel/supergroup ids look like: -100xxxxxxxxxx
# Get it from @userinfobot (DM) or by forwarding a channel post to @userinfobot
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Optional
# HELIUS_API_KEY=
# LEADERBOARD_SEC=21600
# LEADERBOARD_SIZE=15
# EXPANSION_WAIT_SEC=180
# PUMP_POLL_SEC=12
